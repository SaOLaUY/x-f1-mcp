# X (Twitter) authentication via cookies
# Get these from Chrome DevTools > Application > Cookies > x.com
# after logging in to your X account

# auth_token cookie (httpOnly)
X_AUTH_TOKEN=your_auth_token_cookie_here

# ct0 cookie (CSRF token)
X_CT0=your_ct0_cookie_here

# NOTE: X_USERNAME, X_PASSWORD and X_EMAIL are no longer used.
# The agent-twitter-client guest token endpoint was deprecated by X.
# Cookie-based auth is the recommended approach.
